.risk.low { color: #33ff5c; }
.risk.mid { color: #f09b24; }
.risk.high { color: #f53232; }
.fill-tip {
  position: fixed;
  top: 24rpx;
  left: 32rpx;
  right: 32rpx;
  z-index: 200;
  background: #212121;
  color: #fff;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 12rpx 28rpx rgba(33, 33, 33, 0.18);
}
